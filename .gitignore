# ==============================================================================
# AI Competitive Intelligence Platform - Git Ignore Rules
# ==============================================================================

# --- Environment Variables & Secrets ---
.env
.env.local
.env.*.local
*.env

# --- Python & Bytecode ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node.js & React Dependencies ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Production Build Outputs ---
dist/
frontend/dist/
build/
out/

# --- SQLite Databases & Dynamic Storage ---
*.db
*.sqlite
*.sqlite3
backend/database/*.db
database/*.db

# --- Generated PDF Dossiers & Reports ---
reports/*.pdf
*.pdf

# --- Operating System & Editor Files ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- Testing & Coverage Artifacts ---
.pytest_cache/
.coverage
htmlcov/
*.log
